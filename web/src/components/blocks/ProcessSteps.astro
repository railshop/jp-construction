---
/**
 * ProcessSteps.astro (v2)
 * Structural process grid. Oversized Oswald numerals over a hairline track,
 * red tick marking each step. Vertical rail layout on mobile.
 * The eyebrow prop is accepted for compatibility but no longer rendered.
 */

interface Step {
  title: string;
  description: string;
}

interface Props {
  steps: Step[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  variant?: 'light' | 'dark';
}

const {
  steps,
  title = 'How We Work',
  subtitle,
  variant = 'light',
} = Astro.props;
---

<section class:list={['section process-section', `process-section--${variant}`, { 'texture-grid': variant === 'dark' }]}>
  <div class="container">

    <header class="process-header reveal">
      {title   && <h2 class="section-title">{title}</h2>}
      {subtitle && <p class="section-subtitle">{subtitle}</p>}
    </header>

    <ol class="process-list" role="list">
      {steps.map((step, i) => (
        <li class:list={['process-step', 'reveal', `reveal-d${Math.min(i + 1, 5)}`]}>
          <div class="process-track" aria-hidden="true">
            <span class="process-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="process-tick"></span>
          </div>
          <div class="process-content">
            <h3 class="process-title">{step.title}</h3>
            <p class="process-desc">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  /* ─── Section variants ───────────────────────────────────────────────────── */

  .process-section { background: var(--color-bg-subtle); }

  .process-section--dark {
    background: var(--color-brand-950);
  }

  .process-section--dark .section-title,
  .process-section--dark .process-title {
    color: #ffffff;
  }

  .process-section--dark .section-subtitle,
  .process-section--dark .process-desc {
    color: rgba(255, 255, 255, 0.55);
  }

  /* ─── Header ─────────────────────────────────────────────────────────────── */

  .process-header {
    max-width: 720px;
    margin-bottom: var(--space-16);
  }

  /* ─── Grid ───────────────────────────────────────────────────────────────── */

  .process-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 768px) {
    .process-list {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-8);
    }
  }

  /* ─── Step ───────────────────────────────────────────────────────────────── */

  .process-step {
    display: flex;
    flex-direction: column;
  }

  /* Numeral over a hairline with a red tick */
  .process-track {
    position: relative;
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border-strong);
  }

  .process-section--dark .process-track {
    border-color: rgba(255, 255, 255, 0.14);
  }

  .process-num {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 4vw, 3.75rem);
    font-weight: 600;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-brand-300);
    font-variant-numeric: tabular-nums;
    transition: color var(--transition-base), -webkit-text-stroke-color var(--transition-base);
  }

  .process-step:hover .process-num {
    color: var(--color-accent-500);
    -webkit-text-stroke-color: var(--color-accent-500);
  }

  .process-section--dark .process-num {
    -webkit-text-stroke-color: rgba(255, 255, 255, 0.3);
  }

  .process-tick {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 32px;
    height: 3px;
    background: var(--color-accent-500);
    transition: width var(--transition-base);
  }

  .process-step:hover .process-tick { width: 56px; }

  /* ─── Content ────────────────────────────────────────────────────────────── */

  .process-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .process-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .process-desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.75;
    margin: 0;
  }
</style>
