---
/**
 * BaseLayout.astro
 * The HTML shell for every page. Accepts SEO props and slot content.
 */

import SEO, { type SEOProps } from '../components/seo/SEO.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import config from '@/site.config';
import '../styles/global.css';

interface Props {
  seo: SEOProps;
  fullWidthHero?: boolean;
}

const { seo, fullWidthHero = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="no-js">
  <head>
    <SEO seo={seo} />

    <script is:inline>document.documentElement.classList.remove('no-js');</script>

    <!-- Google Fonts — preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Lato:ital,wght@0,400;0,700;1,400&display=swap" />

    <!-- Google Tag Manager -->
    {config.gtmId && (
      <script define:vars={{ gtmId: config.gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer', gtmId);
      </script>
    )}

    <!-- GA4 (only if no GTM) -->
    {config.ga4Id && !config.gtmId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${config.ga4Id}`}></script>
        <script define:vars={{ ga4Id: config.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>
      </>
    )}
  </head>

  <body>
    <!-- GTM noscript -->
    {config.gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${config.gtmId}`}
          height="0" width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}

    <Header />

    <main id="main-content" class:list={[{ 'pt-[var(--header-height)]': !fullWidthHero }]}>
      <slot />
    </main>

    <Footer />

    <!-- Scroll reveal: adds .is-visible to .reveal / .reveal-left elements -->
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        var els = document.querySelectorAll('.reveal, .reveal-left');
        if (!els.length) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>

  </body>
</html>
