---
/**
 * CtaBanner.astro (v2)
 * Conversion band over a dark steel-and-concrete texture photo with a red
 * signal rule. Falls back to flat charcoal if the texture image is absent.
 */

interface Props {
  headline?: string;
  subheadline?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?: 'brand' | 'dark' | 'accent';
  phone?: string;
  phoneHref?: string;
}

const {
  headline = 'Ready to Get Started?',
  subheadline = 'Get your free estimate today. No obligation, no pressure.',
  primaryCta = { label: 'Get an Estimate', href: '/contact/' },
  secondaryCta,
  variant = 'brand',
  phone,
  phoneHref,
} = Astro.props;
---

<section class:list={['cta-banner', `cta-banner--${variant}`]}>
  {variant !== 'accent' && (
    <div class="cta-banner-bg" aria-hidden="true">
      <img src="/images/texture-cta.jpg" alt="" loading="lazy" class="cta-banner-bg-img" onerror="this.parentElement.style.display='none'" />
      <div class="cta-banner-bg-overlay"></div>
    </div>
  )}
  <div class="cta-banner-rule" aria-hidden="true"></div>
  <div class="container">
    <div class="cta-banner-inner reveal">
      <div class="cta-banner-text">
        <h2 class="cta-banner-headline">{headline}</h2>
        {subheadline && <p class="cta-banner-sub">{subheadline}</p>}
      </div>
      <div class="cta-banner-actions">
        <a href={primaryCta.href} class="btn btn-primary btn-lg">
          {primaryCta.label}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        {phone && phoneHref && (
          <a href={phoneHref} class="btn btn-ghost btn-lg">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.77 3.44 2 2 0 0 1 3.74 1.26h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            {phone}
          </a>
        )}
        {secondaryCta && !phone && (
          <a href={secondaryCta.href} class="btn btn-ghost btn-lg">{secondaryCta.label}</a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    padding-block: clamp(4.5rem, 8vw, 7rem);
    position: relative;
    overflow: hidden;
  }

  .cta-banner--brand  { background: var(--color-brand-900); }
  .cta-banner--dark   { background: var(--color-brand-950); }
  .cta-banner--accent { background: var(--color-accent-500); }

  /* Texture photo background */
  .cta-banner-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-banner-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cta-banner-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(10,10,10,0.9) 20%, rgba(10,10,10,0.65) 100%);
  }

  .cta-banner-rule {
    position: absolute;
    top: 0;
    left: 0;
    width: 40%;
    height: 3px;
    background: var(--color-accent-500);
    z-index: 2;
  }

  .cta-banner--accent .cta-banner-rule { background: rgba(0, 0, 0, 0.3); }

  .cta-banner-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    align-items: center;
    text-align: center;
  }

  @media (min-width: 768px) {
    .cta-banner-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
      gap: var(--space-16);
    }
  }

  .cta-banner-text { flex: 1; }

  .cta-banner-headline {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 var(--space-3);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .cta-banner-sub {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
    line-height: 1.65;
  }

  .cta-banner--accent .cta-banner-sub { color: rgba(255,255,255,0.85); }

  .cta-banner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .cta-banner-actions {
      justify-content: flex-start;
    }
  }

  /* On accent variant, btn-primary flips to charcoal */
  .cta-banner--accent :global(.btn-primary) {
    background-color: var(--color-brand-950);
    border-color: var(--color-brand-950);
  }
</style>
