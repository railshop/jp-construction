---
/**
 * Hero.astro (v2)
 * Full-bleed cinematic hero. Dark photo with slow zoom, oversized condensed
 * headline, red signal rule, structural side rail, and a trust strip.
 * Props are unchanged from v1 so existing pages keep working.
 */

interface Props {
  headline: string;
  subheadline?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  backgroundImage?: string;
  badge?: string;
  trustSignals?: string[];
  variant?: 'default' | 'centered' | 'split';
  googleReviews?: { rating: number; url?: string };
  bbbAccredited?: { url?: string };
  jpOpsCredit?: boolean;
  sideRailText?: string;
}

const {
  headline,
  subheadline,
  primaryCta = { label: 'Get an Estimate', href: '/contact/' },
  secondaryCta,
  backgroundImage,
  variant = 'default',
  googleReviews,
  bbbAccredited,
  jpOpsCredit,
  sideRailText = 'North Huntingdon, PA',
} = Astro.props;

const hasTrustStrip = !!(googleReviews || bbbAccredited || jpOpsCredit);
---

<section
  class:list={['hero', `hero--${variant}`, { 'hero--bg': !!backgroundImage }, { 'hero--trust-strip': hasTrustStrip }]}
>
  {backgroundImage ? (
    <div class="hero-bg" aria-hidden="true">
      <img src={backgroundImage} alt="" class="hero-bg-img" loading="eager" fetchpriority="high" />
      <div class="hero-bg-overlay"></div>
    </div>
  ) : (
    <div class="hero-grid-texture" aria-hidden="true"></div>
  )}

  <div class="hero-layout">

    <!-- Structural side rail (desktop only) -->
    <div class="hero-rail animate-fade-in delay-500" aria-hidden="true">
      <span class="hero-rail-line"></span>
      <span class="hero-rail-text">{sideRailText}</span>
    </div>

    <div class="hero-content">
      <h1 class="hero-headline animate-fade-up" set:html={headline} />

      {subheadline && (
        <p class="hero-subheadline animate-fade-up delay-200">{subheadline}</p>
      )}

      <div class="hero-actions animate-fade-up delay-300">
        <a href={primaryCta.href} class="btn btn-primary btn-lg">
          {primaryCta.label}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        {secondaryCta && (
          <a href={secondaryCta.href} class="btn btn-ghost btn-lg">
            {secondaryCta.label}
          </a>
        )}
      </div>
    </div>

  </div>

  {hasTrustStrip && (
    <div class="hero-trust-strip" role="complementary" aria-label="Trust signals">
      <div class="hts-inner">

        {googleReviews && (
          <a
            href={googleReviews.url || 'https://www.google.com/search?q=jp+operations+north+huntingdon+pa'}
            class="hts-item hts-google"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${googleReviews.rating} out of 5 stars on Google`}
          >
            <span class="hts-logo-circle" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.875 2.684-6.615z"/>
                <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
                <path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
                <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
              </svg>
            </span>
            <span class="hts-text-stack">
              <span class="hts-stars" aria-hidden="true">
                {[1,2,3,4,5].map(() => (
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                ))}
              </span>
              <span class="hts-label">Top-Rated on Google</span>
            </span>
          </a>
        )}

        {googleReviews && bbbAccredited && <span class="hts-sep" aria-hidden="true"></span>}

        {bbbAccredited && (
          <a
            href={bbbAccredited.url || 'https://www.bbb.org/us/pa/irwin/profile/excavating-contractors/jp-operations-inc-0141-71023277'}
            class="hts-item hts-bbb"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="BBB Accredited Business"
          >
            <img
              src="/Accredited_Business_Seal_Rating_RGB.svg.svg"
              alt="BBB Accredited Business seal"
              class="hts-bbb-seal"
              loading="eager"
            />
          </a>
        )}

        {(googleReviews || bbbAccredited) && jpOpsCredit && <span class="hts-sep" aria-hidden="true"></span>}

        {jpOpsCredit && (
          <a href="https://www.jpoperations.com/" class="hts-item hts-jpops" target="_blank" rel="noopener noreferrer" aria-label="JP Operations, parent company">
            <span class="hts-jpops-caption">A</span>
            <img
              src="/JP Operations logo white.svg"
              alt="JP Operations"
              class="hts-jpops-logo"
              loading="eager"
            />
            <span class="hts-jpops-caption">Company</span>
          </a>
        )}

      </div>
    </div>
  )}

  <div class="hero-bottom-rule" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--color-brand-950);
    padding-top: calc(var(--header-height) + var(--space-24));
    padding-bottom: var(--space-24);
    overflow: hidden;
    min-height: min(860px, 92vh);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* ─── Background photo with slow zoom ────────────────────────────────────── */

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    animation: heroZoom 22s var(--ease-out-strong) forwards;
    transform-origin: center;
  }

  @keyframes heroZoom {
    from { transform: scale(1); }
    to   { transform: scale(1.09); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-img { animation: none; }
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg,
        rgba(10, 10, 10, 0.92) 0%,
        rgba(10, 10, 10, 0.72) 42%,
        rgba(10, 10, 10, 0.28) 78%,
        rgba(10, 10, 10, 0.15) 100%),
      linear-gradient(to top, rgba(10, 10, 10, 0.65) 0%, transparent 36%);
  }

  .hero-grid-texture {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, black, transparent 92%);
    pointer-events: none;
  }

  /* ─── Layout ─────────────────────────────────────────────────────────────── */

  .hero-layout {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--space-10);
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  @media (min-width: 640px)  { .hero-layout { padding-inline: var(--space-8); } }
  @media (min-width: 1024px) { .hero-layout { padding-inline: var(--space-12); } }

  /* ─── Side rail ──────────────────────────────────────────────────────────── */

  .hero-rail {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    align-self: stretch;
    justify-content: center;
  }

  @media (min-width: 1200px) { .hero-rail { display: flex; } }

  .hero-rail-line {
    width: 1px;
    height: 88px;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.35));
  }

  .hero-rail-text {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    writing-mode: vertical-rl;
    white-space: nowrap;
  }

  /* ─── Content ────────────────────────────────────────────────────────────── */

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-7, 1.75rem);
    max-width: 880px;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(2.875rem, 7vw, 6.25rem);
    font-weight: 600;
    line-height: 0.98;
    color: #ffffff;
    margin: 0;
    letter-spacing: 0.005em;
    text-transform: uppercase;
  }

  .hero-headline :global(em) {
    font-style: normal;
    color: var(--color-accent-500);
  }

  .hero-subheadline {
    font-size: clamp(1rem, 1.8vw, 1.1875rem);
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.75;
    max-width: 560px;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  /* ─── Bottom rule ────────────────────────────────────────────────────────── */

  .hero-bottom-rule {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent-500) 30%, transparent);
    z-index: 3;
  }

  /* ─── Trust Strip ────────────────────────────────────────────────────────── */

  .hero-trust-strip {
    position: absolute;
    bottom: 3px;
    left: 0;
    right: 0;
    z-index: 2;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: var(--space-3);
  }

  .hero--trust-strip {
    padding-bottom: calc(var(--space-24) + 64px);
  }

  .hts-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  @media (min-width: 640px)  { .hts-inner { padding-inline: var(--space-8); } }
  @media (min-width: 1024px) { .hts-inner { padding-inline: var(--space-12); } }

  .hts-sep {
    width: 1px;
    height: 32px;
    background: rgba(255, 255, 255, 0.15);
    flex-shrink: 0;
  }

  .hts-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    transition: opacity var(--transition-fast);
    flex-shrink: 0;
  }

  .hts-item:hover { opacity: 0.75; }

  .hts-logo-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: #ffffff;
    border-radius: 50%;
    flex-shrink: 0;
    padding: 3px;
  }

  .hts-text-stack {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hts-stars {
    display: flex;
    align-items: center;
    gap: 1px;
    color: #FBBF24;
  }

  .hts-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    white-space: nowrap;
    line-height: 1;
  }

  .hts-bbb-seal {
    height: 38px;
    width: auto;
    display: block;
  }

  .hts-jpops {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hts-jpops-logo {
    height: 24px;
    width: auto;
    display: block;
  }

  .hts-jpops-caption {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    line-height: 1;
    white-space: nowrap;
  }

  @media (max-width: 540px) {
    .hts-jpops { display: none; }
    .hts-sep:last-of-type { display: none; }
  }

  /* ─── Centered variant ───────────────────────────────────────────────────── */
  .hero--centered .hero-layout { justify-content: center; }
  .hero--centered .hero-rail { display: none; }
  .hero--centered .hero-content { align-items: center; max-width: 780px; text-align: center; }
  .hero--centered .hero-subheadline { margin-inline: auto; }
</style>
