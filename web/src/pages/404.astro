---
/**
 * pages/404.astro — Not found
 *
 * Astro emits this as dist/404.html, which Netlify serves automatically
 * for any unmatched route.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBusiness, getServices } from '../lib/data';
import { homeUrl, servicesUrl, projectsUrl, contactUrl, serviceUrl } from '../lib/urls';
const business = await getBusiness();
const services = await getServices();
---

<BaseLayout seo={{
  title: 'Page Not Found',
  description: `That page does not exist on the ${business.name} website. Find our services, projects, and contact information here.`,
  noindex: true,
}}>
  <section class="nf">
    <div class="container">
      <p class="nf-code" aria-hidden="true">404</p>
      <h1 class="nf-title">That page isn't on the plans.</h1>
      <p class="nf-desc">
        The link may be outdated or the address mistyped. Here is where to go next.
      </p>
      <div class="nf-actions">
        <a href={homeUrl()} class="btn btn-primary btn-lg">Back to Home</a>
        <a href={contactUrl()} class="btn btn-secondary btn-lg">Get an Estimate</a>
      </div>

      <div class="nf-links">
        <div>
          <p class="nf-links-heading">Services</p>
          <ul role="list">
            {services.map(s => <li><a href={serviceUrl(s.slug)}>{s.name}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="nf-links-heading">Elsewhere</p>
          <ul role="list">
            <li><a href={projectsUrl()}>Our Work</a></li>
            <li><a href={servicesUrl()}>All Services</a></li>
            <li><a href={contactUrl()}>Contact</a></li>
            <li><a href={business.phoneHref}>{business.phone}</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { padding: var(--space-24) 0 var(--space-24); }
  .nf-code { font-family: var(--font-display); font-size: clamp(4rem, 12vw, 9rem); line-height: 1; color: var(--color-accent-500); margin: 0 0 var(--space-2); letter-spacing: 0.02em; }
  .nf-title { font-family: var(--font-display); font-size: var(--text-4xl); text-transform: uppercase; letter-spacing: 0.02em; margin: 0 0 var(--space-4); max-width: 640px; }
  .nf-desc { color: var(--color-text-muted); font-size: var(--text-lg); line-height: 1.65; max-width: 560px; margin: 0 0 var(--space-8); }
  .nf-actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-bottom: var(--space-16); }
  .nf-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 280px)); gap: var(--space-10); border-top: 1px solid var(--color-border); padding-top: var(--space-10); }
  .nf-links-heading { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-subtle); margin: 0 0 var(--space-3); }
  .nf-links ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .nf-links a { color: var(--color-text); text-decoration: none; }
  .nf-links a:hover { color: var(--color-accent-600); text-decoration: underline; text-underline-offset: 2px; }
</style>
