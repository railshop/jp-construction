---
/**
 * pages/careers/index.astro
 * Careers listing for JP Construction and JP Operations.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/blocks/CtaBanner.astro';
import { getBusiness } from '../../lib/data';
import { jobs } from '../../data/careers';

const business = await getBusiness();
---

<BaseLayout seo={{
  title: 'Careers | Join the JP Team',
  description: `Open positions at ${business.name} and JP Operations in North Huntingdon, PA. Local construction and excavation work, home every night.`,
  breadcrumbs: [{ name: 'Careers', url: '/careers/' }],
}}>

  <div class="page-hero">
    <div class="container">
      <h1 class="section-title">Build Your Career.<br/>Close to Home.</h1>
      <p class="section-subtitle">
        JP Construction and JP Operations are hiring across the trades. Local work in Westmoreland County,
        modern equipment, and a team that promotes from within. Home every night.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <h2 class="jobs-heading">Open Positions</h2>
      <ul class="jobs-list" role="list">
        {jobs.map((job, i) => (
          <li class:list={['reveal', `reveal-d${Math.min(i % 3 + 1, 5)}`]}>
            <a href={`/careers/${job.slug}/`} class="job-row">
              <span class="job-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="job-main">
                <span class="job-title">{job.title}</span>
                <span class="job-summary">{job.summary}</span>
              </span>
              <span class="job-meta">
                <span class:list={['job-company', { 'job-company--ops': job.company === 'JP Operations' }]}>{job.company}</span>
                <span class="job-type">{job.type} · {job.location}</span>
              </span>
              <svg class="job-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          </li>
        ))}
      </ul>

      <p class="jobs-note">
        Don't see your trade listed? We're always looking for good people.
        Send your resume to <a href={`mailto:${business.email}`} class="jobs-note-link">{business.email}</a> and tell us what you do.
      </p>
    </div>
  </section>

  <CtaBanner
    headline="Know Someone Who Fits?"
    subheadline="Pass this page along. Good crews are built on good referrals."
    primaryCta={{ label: 'View Open Roles', href: '/careers/' }}
    phone={business.phone}
    phoneHref={business.phoneHref}
    variant="dark"
  />
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: var(--space-24) 0 var(--space-20);
    background-color: var(--color-brand-900);
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/images/about-team.jpg');
    background-size: cover;
    background-position: center 40%;
  }

  .page-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(10,10,10,0.85) 0%, rgba(10,10,10,0.62) 60%, rgba(10,10,10,0.42) 100%),
      linear-gradient(to top, rgba(10,10,10,0.50) 0%, transparent 50%);
  }

  .page-hero .container {
    position: relative;
    z-index: 1;
  }

  .page-hero .section-title { color: #ffffff; }
  .page-hero .section-subtitle { color: rgba(255, 255, 255, 0.72); margin-top: var(--space-3); max-width: 600px; }

  .jobs-heading {
    font-size: var(--text-xl);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .jobs-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .job-row {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition: background var(--transition-fast), padding-left var(--transition-fast);
  }

  .job-row:hover {
    background: var(--color-bg-subtle);
    padding-left: var(--space-4);
  }

  .job-num {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .job-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
    min-width: 0;
  }

  .job-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .job-row:hover .job-title { color: var(--color-accent-500); }

  .job-summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .job-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
    flex-shrink: 0;
    text-align: right;
  }

  .job-company {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-950);
    border: 1px solid var(--color-border-strong);
    padding: var(--space-1) var(--space-3);
  }

  .job-company--ops {
    background: var(--color-brand-950);
    color: #ffffff;
    border-color: var(--color-brand-950);
  }

  .job-type {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .job-arrow {
    color: var(--color-text-subtle);
    flex-shrink: 0;
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .job-row:hover .job-arrow {
    transform: translateX(4px);
    color: var(--color-accent-500);
  }

  .jobs-note {
    margin-top: var(--space-10);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 620px;
  }

  .jobs-note-link {
    color: var(--color-accent-500);
    font-weight: 700;
    text-decoration: none;
  }

  .jobs-note-link:hover { text-decoration: underline; }

  @media (max-width: 767px) {
    .job-row {
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    .job-num { display: none; }

    .job-main { flex-basis: 100%; }

    .job-meta {
      flex-direction: row;
      align-items: center;
      gap: var(--space-3);
      text-align: left;
    }

    .job-arrow { margin-left: auto; }
  }
</style>
