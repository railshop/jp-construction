---
/**
 * pages/careers/[job].astro
 * Individual job posting with application form (Netlify Forms, resume upload).
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBusiness } from '../../lib/data';
import { jobs } from '../../data/careers';
import config from '@/site.config';

export function getStaticPaths() {
  return jobs.map(j => ({ params: { job: j.slug } }));
}

const { job: jobSlug } = Astro.params;
const business = await getBusiness();
const job = jobs.find(j => j.slug === jobSlug)!;

const jobSchema = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: job.title,
  description: job.about,
  employmentType: 'FULL_TIME',
  hiringOrganization: {
    '@type': 'Organization',
    name: job.company,
    sameAs: config.siteUrl,
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: business.address.street,
      addressLocality: business.address.city,
      addressRegion: business.address.state,
      postalCode: business.address.zip,
      addressCountry: 'US',
    },
  },
};
---

<BaseLayout seo={{
  title: `${job.title} at ${job.company}`,
  description: `${job.summary} Apply now: full-time, based in ${job.location}.`,
  schema: jobSchema,
  breadcrumbs: [
    { name: 'Careers', url: '/careers/' },
    { name: job.title, url: `/careers/${job.slug}/` },
  ],
}}>

  <div class="job-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/careers/">Careers</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{job.title}</span>
      </nav>
      <p class="job-hero-company">{job.company}</p>
      <h1 class="job-hero-title">{job.title}</h1>
      <p class="job-hero-meta">{job.type} · {job.location}</p>
      <a href="#apply" class="btn btn-primary btn-lg">Apply for This Role</a>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="job-layout">

        <div class="job-content">
          <div class="job-section">
            <h2 class="job-section-title">About the Role</h2>
            <p class="job-about">{job.about}</p>
          </div>

          <div class="job-section">
            <h2 class="job-section-title">What You'll Do</h2>
            <ul class="job-list" role="list">
              {job.responsibilities.map(item => (
                <li class="job-list-item">{item}</li>
              ))}
            </ul>
          </div>

          <div class="job-section">
            <h2 class="job-section-title">What We're Looking For</h2>
            <ul class="job-list" role="list">
              {job.qualifications.map(item => (
                <li class="job-list-item">{item}</li>
              ))}
            </ul>
          </div>

          <div class="job-section">
            <h2 class="job-section-title">What We Offer</h2>
            <ul class="job-list" role="list">
              {job.offers.map(item => (
                <li class="job-list-item">{item}</li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Application form -->
        <div class="job-apply" id="apply">
          <h2 class="job-apply-title">Apply Now</h2>
          <p class="job-apply-sub">Takes two minutes. We review every application and respond within a few business days.</p>

          <form
            name="job-application"
            method="POST"
            action={`/careers/${job.slug}/?success=true`}
            enctype="multipart/form-data"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="job-form"
            id="job-form"
          >
            <input type="hidden" name="form-name" value="job-application" />
            <input type="hidden" name="position" value={`${job.title} (${job.company})`} />
            <p class="job-honeypot" aria-hidden="true">
              <label>Do not fill this out: <input name="bot-field" /></label>
            </p>

            <div class="form-group">
              <label class="form-label" for="name">Full Name <span class="form-required" aria-label="required">*</span></label>
              <input class="form-input" type="text" id="name" name="name" required autocomplete="name" />
            </div>

            <div class="form-group">
              <label class="form-label" for="email">Email <span class="form-required" aria-label="required">*</span></label>
              <input class="form-input" type="email" id="email" name="email" required autocomplete="email" />
            </div>

            <div class="form-group">
              <label class="form-label" for="phone">Phone <span class="form-required" aria-label="required">*</span></label>
              <input class="form-input" type="tel" id="phone" name="phone" required autocomplete="tel" />
            </div>

            <div class="form-group">
              <label class="form-label" for="experience">Years of Relevant Experience</label>
              <select class="form-select" id="experience" name="experience">
                <option value="">Select...</option>
                <option value="0-1">0 to 1 years</option>
                <option value="2-4">2 to 4 years</option>
                <option value="5-9">5 to 9 years</option>
                <option value="10+">10 or more years</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="resume">Resume <span class="form-optional">(PDF or Word)</span></label>
              <input class="form-input form-file" type="file" id="resume" name="resume" accept=".pdf,.doc,.docx" />
            </div>

            <div class="form-group">
              <label class="form-label" for="message">Anything We Should Know?</label>
              <textarea class="form-textarea" id="message" name="message" rows="4" placeholder="Certifications, equipment you run, availability, referrals..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-lg form-submit-btn">
              Submit Application
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </button>
          </form>

          <div class="apply-success hidden" id="apply-success" role="status" aria-live="polite">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <h3>Application Received</h3>
            <p>Thanks for applying. We review every application and will be in touch within a few business days.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .job-hero {
    padding: var(--space-24) 0 var(--space-16);
    background: linear-gradient(160deg, var(--color-brand-900) 0%, var(--color-brand-950) 100%);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-neutral-400);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .breadcrumb a { color: var(--color-neutral-400); text-decoration: none; }
  .breadcrumb a:hover { color: #ffffff; }
  .breadcrumb span[aria-hidden] { color: var(--color-neutral-600); }

  .job-hero-company {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-400);
    margin: 0 0 var(--space-3);
  }

  .job-hero-title {
    color: #ffffff;
    margin: 0 0 var(--space-3);
  }

  .job-hero-meta {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 var(--space-8);
  }

  /* ── Layout ── */

  .job-layout {
    display: grid;
    gap: var(--space-12);
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .job-layout {
      grid-template-columns: 1fr 440px;
      gap: var(--space-16);
      align-items: start;
    }
  }

  .job-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .job-section-title {
    font-size: var(--text-lg);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .job-about {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin: 0;
    max-width: 68ch;
  }

  .job-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .job-list-item {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .job-list-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 12px;
    height: 2px;
    background: var(--color-accent-500);
  }

  /* ── Application form ── */

  .job-apply {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: var(--space-8);
    scroll-margin-top: calc(var(--header-height) + var(--space-6));
  }

  @media (min-width: 1024px) {
    .job-apply {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
    }
  }

  .job-apply-title {
    font-size: var(--text-2xl);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-2);
  }

  .job-apply-sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-6);
    line-height: 1.6;
  }

  .job-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .form-file {
    padding: var(--space-3);
    cursor: pointer;
  }

  .form-file::file-selector-button {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-950);
    background: transparent;
    border: 1px solid var(--color-border-strong);
    padding: var(--space-2) var(--space-4);
    margin-right: var(--space-4);
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .form-file::file-selector-button:hover {
    border-color: var(--color-brand-950);
  }

  .job-honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ── Success state ── */

  .hidden { display: none !important; }

  .apply-success {
    text-align: center;
    padding: var(--space-10);
    color: var(--color-brand-700);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .apply-success h3 { margin: 0; }
  .apply-success p { color: var(--color-text-muted); margin: 0; }
</style>

<script>
  const form = document.getElementById('job-form') as HTMLFormElement;
  const success = document.getElementById('apply-success');

  if (form && success && window.location.search.includes('success=true')) {
    form.classList.add('hidden');
    success.classList.remove('hidden');
    success.scrollIntoView({ block: 'center' });
  }

  // Explicit scroll for the Apply anchor; native anchor jumps are unreliable
  // on mobile when the body clips horizontal overflow
  document.querySelectorAll<HTMLAnchorElement>('a[href="#apply"]').forEach(a => {
    a.addEventListener('click', (e) => {
      const target = document.getElementById('apply');
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.replaceState(null, '', '#apply');
    });
  });
</script>
