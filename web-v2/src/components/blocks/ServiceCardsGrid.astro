---
/**
 * ServiceCardsGrid.astro (v2)
 * Photo-forward service cards with index numerals and a red signal rule on
 * hover. Section header is left-aligned and structural. The eyebrow prop is
 * accepted for compatibility but no longer rendered.
 */

import type { Service } from '../../lib/data';

interface Props {
  services: Service[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  columns?: 2 | 3 | 4;
  showPricing?: boolean;
  showViewAll?: boolean;
  areaSlug?: string;
}

const {
  services,
  title = 'What We Build',
  subtitle,
  columns = 3,
  showPricing = false,
  showViewAll = true,
  areaSlug,
} = Astro.props;
---

<section class="section services-grid-section">
  <div class="container">
    {(title || subtitle) && (
      <header class="section-header reveal">
        {title   && <h2 class="section-title">{title}</h2>}
        {subtitle && <p class="section-subtitle">{subtitle}</p>}
      </header>
    )}

    <ul
      class:list={['services-grid', `services-grid--cols-${columns}`]}
      role="list"
    >
      {services.map((service, i) => (
        <li class:list={['reveal', `reveal-d${Math.min(i % 3 + 1, 5)}`]}>
          <a
            href={areaSlug ? `/services/${areaSlug}/${service.slug}/` : `/services/${service.slug}/`}
            class="service-card card"
          >
            <div class="service-card-media">
              {service.image ? (
                <img
                  src={service.image}
                  alt=""
                  loading="lazy"
                  width="700"
                  height="525"
                />
              ) : (
                <div class="service-card-media-fallback" aria-hidden="true"></div>
              )}
              <span class="service-card-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="service-card-body">
              <div class="service-card-header">
                <h3 class="service-card-title">{service.name}</h3>
                {service.emergency && (
                  <span class="badge badge-accent" aria-label="Available 24/7">24/7</span>
                )}
              </div>
              <p class="service-card-desc">{service.shortDescription}</p>
              {showPricing && service.priceRange && (
                <p class="service-card-price">
                  Starting from ${service.priceRange.min.toLocaleString()}
                </p>
              )}
              <span class="service-card-cta" aria-hidden="true">
                Learn More
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    {showViewAll && (
      <div class="services-grid-cta reveal">
        <a href="/services/" class="btn btn-secondary">View All Services</a>
      </div>
    )}
  </div>
</section>

<style>
  .section-header {
    margin-bottom: var(--space-12);
    max-width: 720px;
  }

  .services-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .services-grid--cols-2,
    .services-grid--cols-3,
    .services-grid--cols-4 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .services-grid--cols-3 { grid-template-columns: repeat(3, 1fr); }
    .services-grid--cols-4 { grid-template-columns: repeat(4, 1fr); }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  /* Media */
  .service-card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-brand-900);
  }

  .service-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-slow);
  }

  .service-card:hover .service-card-media img {
    transform: scale(1.05);
  }

  .service-card-media-fallback {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .service-card-num {
    position: absolute;
    bottom: 0;
    left: 0;
    padding: var(--space-1) var(--space-3);
    background: var(--color-brand-950);
    color: rgba(255, 255, 255, 0.55);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
    transition: color var(--transition-base), background var(--transition-base);
  }

  .service-card:hover .service-card-num {
    background: var(--color-accent-500);
    color: #ffffff;
  }

  /* Body */
  .service-card-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .service-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .service-card-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    line-height: 1.2;
  }

  .service-card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .service-card-price {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-brand-700);
    margin: 0;
  }

  .service-card-cta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-950);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    transition: gap var(--transition-fast), color var(--transition-fast);
  }

  .service-card:hover .service-card-cta {
    gap: var(--space-3);
    color: var(--color-accent-500);
  }

  .services-grid-cta {
    text-align: center;
    margin-top: var(--space-12);
  }
</style>
